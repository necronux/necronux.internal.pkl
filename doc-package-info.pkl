/// The necronux internal pkl package.
///
/// Pkl modules intended for shared internal use across repositories in the necronux organization.
amends "pkl:DocPackageInfo"

name = "necronux.internal.pkl"
version = "0.9.0-dev"
importUri = "package://pkg.pkl-lang.org/github.com/necronux/\(name)/\(name)@\(version)/"
authors {
  "Nayan (NayanTheSpaceGuy) <nayantsg@proton.me>"
}
sourceCode = "https://github.com/necronux/\(name)"
issueTracker = "\(sourceCode)/issues"
