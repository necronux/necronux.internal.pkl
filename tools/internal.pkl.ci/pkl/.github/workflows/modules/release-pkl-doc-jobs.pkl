@ModuleInfo { minPklVersion = "0.27.0" }
module ReleasePklDocJobs

import ".../schemas/GitHubAction.pkl" as gha

import ".../gha/ActionsRegistry.pkl" as ActReg
import ".../gha/StepsCommon.pkl"
import ".../gha/UtilsCommon.pkl"

const function generatePklDoc() = new gha.Job {
  name = "Generate Pkl Doc"
  permissions {
    contents = "write"
  }
  steps {
    StepsCommon.checkout(0)
    new {
      name = "Setup worktree for docs"
      run = """
        git config --global user.name 'github-actions[bot]'
        git config --global user.email "41898282+github-actions[bot]@users.noreply.github.com"
        git worktree add tmp-docs docs
        """
    }
    StepsCommon.installAction("just")
    new {
      name = "Generate pkl doc"
      run = "just make-internalpkldoc"
      shell = "bash"
    }
    new {
      name = "Update docs in docs branch and push"
      `working-directory` = "tmp-docs"
      run = """
        git add .
        git commit --amend -m "Update docs"
        git push --force origin docs
        """
    }
    new {
      name = "Upload artifact for GitHub Pages"
      uses = ActReg.uploadPagesArtifact
      with {
        ["path"] = "tmp-docs"
      }
    }
  }
} |> UtilsCommon.standardJobConfig(null, null)
