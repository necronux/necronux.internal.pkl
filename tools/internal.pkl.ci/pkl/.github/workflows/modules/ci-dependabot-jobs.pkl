@ModuleInfo { minPklVersion = "0.27.0" }
module CiDependabotJobs

import ".../schemas/GitHubAction.pkl" as gha

import ".../gha/ActionsRegistry.pkl" as ActReg
import ".../gha/StepsCommon.pkl"
import ".../gha/UtilsCommon.pkl"

const function checkActionUpdate() = new gha.Job {
  `if` = "github.event.pull_request.user.login == 'dependabot[bot]'"
  name = "Check Action Update"
  outputs {
    ["shouldUpdatePklWorkflows"] = "${{ steps.dependabotMetadata.outputs.package-ecosystem == 'github-action' }}"
    ["previousDependencyName"] = "${{ steps.dependencyName.outputs.previous-dependency-name }}"
    ["newDependencyName"] = "${{ steps.dependencyName.outputs.new-dependency-name }}"
  }
  steps {
    new {
      name = "Fetch dependabot metadata"
      id = "dependabotMetadata"
      uses = ActReg.fetchMetadata
    }
    new {
      name = "Get dependency name"
      id = "dependencyName"
      // Fallback: Parse from PR title if versions are empty
      run = """
        echo '${{ steps.dependabotMetadata.outputs.updated-dependencies-json }}' > deps.json
        dependency_name=$(jq -r '.[0].dependencyName' deps.json)
        previous_version=$(jq -r '.[0].prevVersion' deps.json)
        new_version=$(jq -r '.[0].newVersion' deps.json)

        if [[ -z "$previous_version" || -z "$new_version" ]]; then
          pr_title="${{ github.event.pull_request.title }}"
          echo "Dependabot PR title: $pr_title"
          previous_version=$(echo "$pr_title" | grep -oP 'from v?\\K[0-9\\.]+')
          new_version=$(echo "$pr_title" | grep -oP 'to v?\\K[0-9\\.]+')
        fi

        if [[ -z "$dependency_name" || -z "$previous_version" || -z "$new_version" ]]; then
          echo "::error::Could not determine dependency name or versions. Aborting."
          exit 1
        fi

        echo "previous-dependency-name=$dependency_name@v$previous_version" >> $GITHUB_OUTPUT
        echo "new-dependency-name=$dependency_name@v$new_version" >> $GITHUB_OUTPUT
        """
    }
  }
} |> UtilsCommon.standardJobConfig(null, null)

const function updatePklWorkflows() = new gha.Job {
  `if` = "${{ needs.checkActionUpdate.outputs.shouldUpdatePklWorkflows }}"
  name = "Update Pkl Workflows"
  permissions {
    contents = "write"
  }
  steps {
    StepsCommon.checkoutWithRef(null, "${{ github.event.pull_request.head.ref }}")
    new {
      name = "Update dependencies in pkl files"
      run = """
        SEARCH_DIR="tools/internal.pkl.ci/pkl/.github/workflows"
        OLD="${{ needs.checkActionUpdate.outputs.previousDependencyName }}"
        NEW="${{ needs.checkActionUpdate.outputs.newDependencyName }}"
        grep -rl -- "$OLD" "$SEARCH_DIR" | while read -r file; do
          echo "Updating $file"
          sed -i "s|$OLD|$NEW|g" "$file"
        done
        """
    }
    new {
      name = "Commit and push changes"
      uses = ActReg.verifiedBotCommit
      with {
        ["ref"] = "${{ github.event.pull_request.head.ref }}"
        ["message"] = "Update pkl workflows"
        ["files"] = """
          **
          """
      }
    }
  }
} |> UtilsCommon.standardJobConfig(null, null)
