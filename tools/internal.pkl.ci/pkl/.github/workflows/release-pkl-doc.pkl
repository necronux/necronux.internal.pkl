@ModuleInfo { minPklVersion = "0.27.0" }
module ReleasePklDoc

amends ".../schemas/GitHubAction.pkl"

import ".../gha/JobsReleasePklDoc.pkl" as JobsPklDoc
import ".../gha/UtilsCommon.pkl"

headercomment = UtilsCommon.headerComment("2025", "Nayan Patil <nayantsg@proton.me>", "Apache-2.0")
name = "Release-Pkl-Doc"
permissions = (UtilsCommon.contentPermissions("read")) {}

on {
  push {
    branches {
      "main"
    }
  }
}
jobs {
  ["generate-pkl-doc"] = (JobsPklDoc.generatePklDoc("0.27.0", "gha/*.pkl schemas/*.pkl *.pkl")) {}
  ["deploy-doc-to-pages"] = (JobsPklDoc.deployDocToPages()) {
    needs {
      "generate-pkl-doc"
    }
  }
}
